#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
           bindings = <
&kp TAB         &kp Q  &kp W         &kp E     &kp R      &kp T       &kp Y       &kp U  &kp I      &kp O       &kp P     &kp BSPC
&kp ESC         &kp A  &kp S         &kp D     &kp F      &kp G       &kp H       &kp J  &kp K      &kp L       &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X         &kp C     &kp V      &kp B       &kp N       &kp M  &kp COMMA  &kp PERIOD  &kp FSLH  &kp RIGHT_SHIFT
&kp LCTRL       &mo 2  &kp LEFT_WIN  &kp LALT  &none      &none       &none       &none  &none      &kp RALT    &mo 2     &kp RCTRL
                                     &mo 1     &kp SPACE  &mkp MB3    &kp ENTER   &mo 1
                                               &mkp MB1   &mkp MB2    &kp DELETE
            >;

            trackball-bindings = <&tmv_coarse>;
        };

        layer_1 {
            bindings = <
&kp F1          &kp F2  &kp F3        &kp F4    &kp F5     &kp F6      &kp F7         &kp F8            &kp F9             &kp F10    &kp F11    &kp F12
&kp GRAVE       &kp N1  &kp N2        &kp N3    &kp N4     &kp N5      &kp N6         &kp N7            &kp N8             &kp N9     &kp N0     &kp BSPC
&kp LEFT_SHIFT  &none   &kp PSCRN     &none     &none      &none       &kp BSLH       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS  &kp EQUAL  &kp RIGHT_SHIFT
&kp LCTRL       &none   &kp LEFT_WIN  &kp LALT  &none      &none       &kp C_AC_BACK  &kp C_AC_FORWARD  &none              &kp RALT   &none      &kp RCTRL
                                      &none     &kp SPACE  &mkp MB3    &kp ENTER      &none
                                                &mkp MB1   &mkp MB2    &kp DELETE
            >;

            trackball-bindings = <&tsl>;
        };

        layer_2 {
            bindings = <
&kp CAPS        &none      &none         &none         &none         &bt BT_NXT    &none       &none     &kp UP    &kp HOME   &kp END    &none
&none           &none      &none         &none         &none         &bt BT_CLR    &none       &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_UP  &kp PG_DN
&kp LEFT_SHIFT  &kp LALT   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none         &none       &none     &none     &none      &none      &kp RIGHT_SHIFT
&kp LCTRL       &none      &kp LEFT_WIN  &kp LALT      &none         &none         &none       &none     &none     &kp RALT   &none      &kp RCTRL
                                         &none         &kp SPACE     &mkp MB3      &kp ENTER   &none
                                                       &mkp MB1      &mkp MB2      &kp DELETE
            >;

            trackball-bindings = <&tsl>;
        };
    };
};
